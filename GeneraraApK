
name: Generar APK Android

on:
  workflow_dispatch:
  push:
    branches: [main, master]

jobs:
  build:
    runs-on: ubuntu-latest
    steps:
      - name: Descargar repositorio
        uses: actions/checkout@v4

      - name: Preparar Java
        uses: actions/setup-java@v4
        with:
          distribution: temurin
          java-version: '17'

      - name: Preparar Gradle
        uses: gradle/actions/setup-gradle@v4
        with:
          gradle-version: '8.9'

      - name: Extraer proyecto Android
        run: |
          unzip -o Proyecto_Calculadora_Agendas.zip -d android-project

      - name: Compilar APK
        run: |
          cd android-project
          gradle assembleDebug

      - name: Guardar APK
        uses: actions/upload-artifact@v4
        with:
          name: CalculadoraAgendas-APK
          path: android-project/app/build/outputs/apk/debug/app-debug.apk
          if-no-files-found: error
